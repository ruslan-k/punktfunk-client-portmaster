# Punktfunk PortMaster runtime knobs.
# Edit this file on the SD card after installation.

# "browse" opens Punktfunk's controller-driven library.
# "desktop" connects directly to the remote desktop.
PUNKTFUNK_START_MODE=browse

# Decode backend. The default runs the native Cedar hardware decoder through
# the device's vendor libvdecoder stack (H.264, 8-bit 4:2:0): decoded pictures
# are copied into the CPU planar path, and init or a decode-error streak falls
# back down the standard ladder (software included). Values: auto |
# native-cedar | software.
PUNKTFUNK_DECODER=native-cedar

# Cedar preserves every decoded picture in a bounded FIFO by default.
# Diagnostic controls (leave commented for normal use):
# PUNKTFUNK_CEDAR_FIFO=0     # old newest-wins behavior, discards burst pictures
# PUNKTFUNK_CEDAR_PROFILE=1  # opt-in phase census/timers every 120 input AUs

# auto | kmsdrm | x11 | wayland
# auto selects direct KMSDRM when the firmware exports no desktop display.
PUNKTFUNK_VIDEO_DRIVER=auto

# SpruceOS asound-setup.sh exposes the current speaker/Bluetooth route as "default".
PUNKTFUNK_ALSA_DEVICE=default

# Increase to debug when collecting diagnostics.
RUST_LOG=info
