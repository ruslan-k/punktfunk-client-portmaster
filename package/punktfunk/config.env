# Punktfunk PortMaster runtime knobs.
# Edit this file on the SD card after installation.

# "browse" opens Punktfunk's controller-driven library.
# "desktop" connects directly to the remote desktop.
PUNKTFUNK_START_MODE=browse

# Conservative TSPS default. The Mali GPU is still used by the Vulkan presenter,
# but video decode starts on the software H.264 rung instead of assuming Vulkan Video.
# Try "auto" later if the device exposes a usable V4L2/Vulkan decode path.
PUNKTFUNK_DECODER=software

# auto | x11 | wayland
PUNKTFUNK_VIDEO_DRIVER=auto

# Increase to debug when collecting diagnostics.
RUST_LOG=info
